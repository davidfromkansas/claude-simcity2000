[{"t":"2026-10-16T15:03:24Z","date":"Jan 2000","type":"strategy","text":"Attempt 17: attempt 16's plan (factories next to homes) with more job land, police in each district, and homes taxed at least 6%.","population":0,"money":2796},{"t":"2026-10-16T15:03:24Z","date":"Jan 2000","type":"budget","text":"Loan #1 ($10,000). Taxes 4/4/3 until 3,000 people, then homes at least 6%.","population":0,"money":2796},{"t":"2026-10-16T15:03:24Z","date":"Jan 2000","type":"build","text":"Day one (a15-day1, dense).","population":0,"money":2796},{"t":"2026-10-16T15:03:24Z","date":"Jan 2000","type":"commentary","text":"Attempt 16 reached 24,870, the best since attempt 4, by putting factories next to homes. It then ran short of jobs (unemployment 15%+) and money. Attempt 17 adds job land, police and a home-tax floor of 6%.","population":0,"money":2796},{"t":"2026-10-16T15:13:33Z","date":"Feb 2002","type":"budget","text":"Loan #2 ($10,000).","population":2620,"money":1991},{"t":"2026-10-16T15:13:33Z","date":"Feb 2002","type":"build","text":"Job-heavier blocks 3+4 (a17-2003: three home cells became factory/shop cells, each next to homes) with a police station ($9,657). Coal #2 waits for cash.","population":2620,"money":1991},{"t":"2026-10-16T15:23:47Z","date":"Jul 2002","type":"budget","text":"Loan #3 ($10,000): power under 10%.","population":4140,"money":1331},{"t":"2026-10-16T15:23:47Z","date":"Jul 2002","type":"build","text":"Coal #2 + 5 pumps, seaport + 19 north pumps.","population":4140,"money":1331},{"t":"2026-10-16T15:24:14Z","date":"Dec 2002","type":"budget","text":"Tax controller: homes 4 -> 5 (demand 1276), shops 4 -> 5 (demand 2000), factories 3 -> 4 (demand 2000)","population":6600,"money":1331},{"t":"2026-10-16T15:24:40Z","date":"Feb 2003","type":"budget","text":"Tax controller: homes 5 -> 6 (demand 1072), shops 5 -> 6 (demand 2000), factories 4 -> 5 (demand 2000)","population":7480,"money":248},{"t":"2026-10-16T15:34:16Z","date":"Jul 2003","type":"budget","text":"Loan #4 ($